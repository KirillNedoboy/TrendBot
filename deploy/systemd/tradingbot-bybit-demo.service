[Unit]
Description=TradingBot Binance signals and Bybit Demo execution
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
DynamicUser=yes
StateDirectory=tradingbot-bybit-demo
StateDirectoryMode=0700
WorkingDirectory=/var/lib/tradingbot-bybit-demo
LoadCredentialEncrypted=bybit-demo-api-key:/etc/credstore.encrypted/tradingbot-bybit-demo/bybit-demo-api-key.cred
LoadCredentialEncrypted=bybit-demo-api-secret:/etc/credstore.encrypted/tradingbot-bybit-demo/bybit-demo-api-secret.cred
ExecStart=/opt/tradingbot-bybit-demo/current/TradingBot.App bybit-demo run --config /opt/tradingbot-bybit-demo/current/bybit-demo.example.json --flow /opt/tradingbot-bybit-demo/current/signal-only.flow-25.example.json --donchian-30m /opt/tradingbot-bybit-demo/current/signal-only.donchian-flow-30m.example.json --donchian-1h /opt/tradingbot-bybit-demo/current/signal-only.donchian-flow.example.json --confirm-demo-orders --service-approval /etc/tradingbot-bybit-demo/service-approval.json $TRADINGBOT_TELEGRAM_OPTIONS
Restart=on-failure
RestartSec=15
KillSignal=SIGTERM
TimeoutStopSec=45
UMask=0077
LimitCORE=0
Environment=DOTNET_EnableDiagnostics=0
Environment=TRADINGBOT_TELEGRAM_OPTIONS=
CPUQuota=200%
MemoryHigh=2G
MemoryMax=2560M
TasksMax=128
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tradingbot-bybit-demo

[Install]
WantedBy=multi-user.target
